      <a class="zoom-fab zoom-btn-md " style="background: black;color:white" href="javascript:void(0);" data-toggle="tooltip" data-placement="top" title="" data-original-title="Create New" id="btn-add"
      ng-click="add()"><i class="fas fa-plus"></i></a>
    </div>

    <div class="modal fade" id="modal-add">
