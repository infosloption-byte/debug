    <div class="row clearfix">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12">
             <div class="card" id="panel">
                <div class="header">
                    <h2>%%crudNameCap%%</h2>
                    <ul class="header-dropdown">
                        
                    </ul>
                </div>
                <div class="body">
                    <div class="table-responsive">
                        <table class="table m-b-0 c_list">
                            <thead>
                                <tr>
                                   <th>id</th><th>name</th>%%formHeadingHtml%%<th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-repeat="item in details">
                                    <td>@{{item.id}}</td>
                                    <td>@{{item.name}}</td>
                                    %%formBodyHtml%%
                                    <td>
                                        <button type="button" class="btn btn-info btn-edit" title="Edit"
                                        ng-click="edit(item)"><i class="fa fa-edit"></i></button>

                                        <button type="button" data-type="confirm" 
                                        class="btn btn-danger js-sweetalert btn-delete" 
                                         ng-click="delete(item)"
                                        title="Delete"><i class="fa fa-trash"></i></button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>   

        </div>
    </div> 

