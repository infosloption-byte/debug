<script type="text/javascript">

$(document).ready(function(){

    $(".select2").select2({
        width: 'resolve'
    });

    $('#fileToUpload').change(function(e){
        $('#file_prev').val(e.target.files[0].name);
    });
        
});

var app = angular.module("ngApp",['angularMoment','angularImgFallback']);
//controller
app.controller("NgController", function($scope,$http){

    $scope.details = null;
    $scope.record  = null;
    $scope.id      = null;


    //DUMMY
    $scope.details = [{'id':1,'name':'DUMMY'}];


    $scope.loadData = function(){
        /*LOAD DATA TO TABLE
        $.ajax({
            url: "{{url('/%%routeGroup%%get-data')}}",
            type: 'GET',
            data: {},
            success: function (data) {
                $scope.details = data.data;
                $scope.$apply();
            },
            error:function(data) {
              $('.dialog-loader').hide();
            }
        });
        */
    };

    $scope.loadData();

    $("form#form-add").submit(function(e) {
        e.preventDefault();    
        $('.dialog-loader').show();
        var formData = new FormData(this);
        $.ajax({
            url: "{{url('/%%routeGroup%%create')}}",
            type: 'POST',
            data: formData,
            success: function (data) {
                $('.dialog-loader').hide();
                swal({
                    title: "Success!",
                    text: "Record Added ",
                });
                location.reload();
            },
            error:function(data) {
              $('.dialog-loader').hide();
            },
            cache: false,
            contentType: false,
            processData: false
        });
        
        return false;
    });

    $scope.edit = function(item) {
        $scope.id = item.id;

        $('#modal-edit').modal('show'); //DELETE THIS WHEN DEVELOPMENT

        /*LOAD UPDATE ITEM
        $.ajax({
            url: "{{url('/%%routeGroup%%get-by-id')}}",
            type: 'GET',
            data: {id:item.id},
            success: function (data) {
                $scope.record = data.data;
                $scope.$apply();
                $('#modal-edit').modal('show');
            },
            error:function(data) {
              $('.dialog-loader').hide();
            }
        });
        */
        
    };

    $scope.delete = function(item) {
        $scope.id = item.id;
    };

    $scope.add = function() {
        $scope.item = null;
        $('#modal-add').modal('show');
    };

    $("form#form-edit").submit(function(e) {
        e.preventDefault();    
        $('.dialog-loader').show();
        var formData = new FormData(this);
        $.ajax({
            url: "{{url('/%%routeGroup%%update')}}/"+$scope.id,
            type: 'POST',
            data: formData,
            success: function (data) {
                $('.dialog-loader').hide();
                swal({
                    title: "Success!",
                    text: "Record Updated ",
                });
                location.reload();
            },
            error:function(data) {
              $('.dialog-loader').hide();
            },
            cache: false,
            contentType: false,
            processData: false
        });
        
        return false;
    });
        
});//end controller

</script>
@stop























































